# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/orchestration

# HTTP server port (optional, default 3000)
PORT=3000

# Gmail credentials for SEND_EMAIL task (optional)
EMAIL_USER=
EMAIL_PASS=

# Prisma query logging in development (optional)
NODE_ENV=development

# Optional API key — when set, clients must send X-API-Key header
API_KEY=

# Worker tuning (optional)
WORKER_POLL_MS=1000
EXECUTOR_POLL_MS=500
